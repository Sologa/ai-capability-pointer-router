{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sologa/ai-capability-pointer-router/schemas/anchor-check-report.schema.json",
  "title": "Upstream Anchor Check Report",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id",
      "locator",
      "path",
      "exists",
      "checked_ref",
      "checked_at",
      "resolved_commit",
      "blob_sha",
      "url",
      "error",
      "metadata_error"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "locator": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
      },
      "exists": {
        "type": "boolean"
      },
      "checked_ref": {
        "type": "string",
        "minLength": 1
      },
      "checked_at": {
        "type": "string",
        "format": "date-time"
      },
      "resolved_commit": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-f]{40}$"
      },
      "blob_sha": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-f]{40}$"
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "metadata_error": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
